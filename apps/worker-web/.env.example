# Shreeram Daily Milk — worker web app environment variables
#
# Copy this file to .env.local and fill in real values (the same two as
# apps/web). NEVER commit a file containing real values.
#
# Only NEXT_PUBLIC_* variables reach the browser; they are visible to anyone
# and protected by Row-Level Security. Never add a privileged key (service
# role, etc.) here.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
