# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real secrets
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# test coverage
coverage/

# local SQLite databases (offline delivery data — device-local, never committed)
*.sqlite
*.sqlite3
*.db

example

# generated native folders
/ios
/android
